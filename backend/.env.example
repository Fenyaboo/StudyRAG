APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Backend PostgreSQL: copy the exact Session Pooler (port 5432) string from Supabase Dashboard > Connect.
# Do not use the Transaction Pooler (port 6543) with asyncpg prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_SECRET=
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=<dify-api-key>
DIFY_TIMEOUT_SECONDS=120
S3_BUCKET_NAME=<bucket>
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
MAX_UPLOAD_SIZE_BYTES=52428800
# Giới hạn thời gian xử lý một tài liệu (parse + chunk + embed), đồng thời là ngưỡng
# để job recovery lúc startup đánh dấu failed cho document còn treo ở processing.
INGEST_TIMEOUT_SECONDS=900
MAX_RETRIEVAL_RESULTS=8
RRF_K=60
CHAT_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
