APP_ENV=development
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy. Trên production phải là
# origin thật của frontend (ví dụ https://studyrag.bond); để nguyên localhost sẽ khiến
# browser bị CORS chặn toàn bộ request, kể cả /api/v1/ready mà frontend dùng để đọc cờ AI.
FRONTEND_ORIGINS=http://localhost:5173
# Backend PostgreSQL: copy the exact Session Pooler (port 5432) string from Supabase Dashboard > Connect.
# Do not use the Transaction Pooler (port 6543) with asyncpg prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_SECRET=
# Các biến DIFY_* và EMBEDDING_* chỉ được dùng khi AI_FEATURES_ENABLED=true. Ở chế độ
# tạm ngưng chúng không được đọc và không tham gia điều kiện readiness, nên có thể để
# nguyên giá trị placeholder.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=<dify-api-key>
DIFY_TIMEOUT_SECONDS=120
S3_BUCKET_NAME=<bucket>
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
MAX_UPLOAD_SIZE_BYTES=52428800
# Giới hạn thời gian xử lý một tài liệu (parse + chunk + embed), đồng thời là ngưỡng
# để job recovery lúc startup đánh dấu failed cho document còn treo ở processing.
INGEST_TIMEOUT_SECONDS=900
MAX_RETRIEVAL_RESULTS=8
RRF_K=60
CHAT_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
# Bật/tắt toàn bộ tính năng AI (embedding, hybrid retrieval, chat qua Dify).
# Giá trị hợp lệ: true, 1, yes, on (bật) | false, 0, no, off (tắt). Mặc định: false.
# Đặt true yêu cầu cài thêm tập dependency AI tùy chọn:
#   pip install -r backend/requirements-ai.txt
AI_FEATURES_ENABLED=false
