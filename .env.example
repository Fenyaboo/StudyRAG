# Shared / deployment
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,https://studyrag.bond

# Backend PostgreSQL: copy the exact Session Pooler (port 5432) string from Supabase Dashboard > Connect.
# Do not use the Transaction Pooler (port 6543) with asyncpg prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<frontend-safe-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<backend-only-service-role-key>
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Only required when using legacy HS256 JWT signing; leave empty for JWKS/RS256.
SUPABASE_JWT_SECRET=

# Dify Chatbot application
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=<dify-app-api-key>
DIFY_TIMEOUT_SECONDS=120

# Private S3 bucket
S3_BUCKET_NAME=<private-bucket-name>
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<iam-access-key>
AWS_SECRET_ACCESS_KEY=<iam-secret-key>

# Embeddings
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Limits / operational settings
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_RETRIEVAL_RESULTS=8
RRF_K=60
CHAT_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# Frontend (Vite only exposes VITE_* values)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<frontend-safe-anon-key>
VITE_API_BASE_URL=http://localhost:8000/api/v1
